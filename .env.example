OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional OpenRouter app attribution headers.
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=Hackaton Project

# CopilotKit Intelligence is required by `npm run channel`.
CPK_INTELLIGENCE_API_KEY=your-copilotkit-intelligence-api-key

# Telegram Channel. Create the bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-telegram-bot-token

# Optional: channel name used by CopilotKit. Defaults to "telegram" if omitted.
TELEGRAM_CHANNEL_NAME=telegram

# Optional: defaults to long-polling, which does not need a public URL.
# Set to "webhook" or "auto" only when deploying behind a public HTTPS domain.
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_DOMAIN=
TELEGRAM_WEBHOOK_PATH=
TELEGRAM_WEBHOOK_PORT=
TELEGRAM_WEBHOOK_SECRET=
